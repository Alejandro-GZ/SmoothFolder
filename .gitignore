# ============================================================
# SmoothFolder - .gitignore
# .NET 10 / WPF / Windows
# ============================================================

# ----------------------------
# .NET build outputs
# ----------------------------
[Bb]in/
[Oo]bj/
artifacts/
publish/
out/

# ----------------------------
# Visual Studio
# ----------------------------
.vs/
*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb

# Visual Studio cache / generated files
Generated\ Files/
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile

# ----------------------------
# JetBrains Rider / ReSharper
# ----------------------------
.idea/
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# ----------------------------
# VS Code
# ----------------------------
.vscode/

# ----------------------------
# NuGet
# ----------------------------
*.nupkg
*.snupkg
packages/

# Keep NuGet package config files
!packages.config

# ----------------------------
# Test / coverage outputs
# ----------------------------
TestResults/
*.trx
*.coverage
*.coveragexml
coverage/
coverage-results/

# ----------------------------
# Publish-specific local data
# ----------------------------
*.pubxml.user

# ----------------------------
# Local environment / secrets
# ----------------------------
.env
.env.*
!.env.example

appsettings.Local.json
appsettings.*.local.json

# ----------------------------
# Logs / crash dumps
# ----------------------------
*.log
logs/
*.dmp
*.dump
*.mdmp

# ----------------------------
# Temporary files
# ----------------------------
*.tmp
*.temp
*.bak
*.old
*.orig
*.rej
*.swp
*.swo
*~
~$*

# ----------------------------
# Windows
# ----------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# ----------------------------
# macOS (por si el repo se abre allí)
# ----------------------------
.DS_Store
.AppleDouble
.LSOverride

# ----------------------------
# Misc generated files
# ----------------------------
*.pid
*.pid.lock