<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <ApplicationIcon>Assets\SmoothFolder.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SmoothFolder</AssemblyName>
    <RootNamespace>SmoothFolder</RootNamespace>
    <Product>SmoothFolder</Product>
    <Description>iOS-inspired application folders for the Windows desktop.</Description>
    <Authors>SmoothFolder contributors</Authors>
    <Copyright>Copyright © SmoothFolder contributors</Copyright>
  </PropertyGroup>

</Project>
