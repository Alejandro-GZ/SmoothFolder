<Window x:Class="SmoothFolder.Views.FolderPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="540"
        Height="472"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid x:Name="PopupRoot"
          Margin="1"
          Background="Transparent"
          RenderTransformOrigin="0.5,0.5"
          PreviewMouseLeftButtonDown="PopupSurface_PreviewMouseLeftButtonDown">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
                <TranslateTransform X="0" Y="0"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- iOS-style folder title: outside the glass surface, top-left. -->
        <Border Grid.Row="0"
                Background="Transparent"
                Margin="12,0,0,2">
            <TextBlock x:Name="TitleText"
                       FontFamily="{DynamicResource UiFontFamily}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#D9000000"
                                      BlurRadius="7"
                                      ShadowDepth="1"
                                      Opacity="0.88"/>
                </TextBlock.Effect>
            </TextBlock>
        </Border>

        <Border x:Name="PopupCard"
                Grid.Row="1"
                CornerRadius="30"
                BorderBrush="#58FFFFFF"
                BorderThickness="1">
            <Grid>
                <Border x:Name="TintLayer"
                        Margin="1"
                        CornerRadius="29"
                        IsHitTestVisible="False"/>

                <!-- Layered highlights make the translucent tint read as glass. -->
                <Border Margin="1"
                        CornerRadius="29"
                        IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#18FFFFFF" Offset="0"/>
                            <GradientStop Color="#08FFFFFF" Offset="0.30"/>
                            <GradientStop Color="#03FFFFFF" Offset="0.62"/>
                            <GradientStop Color="#02FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border Margin="1"
                        CornerRadius="29"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        IsHitTestVisible="False"/>

                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>

                    <!--
                    A fixed 4x3 page replaces the old vertical ScrollViewer.
                    The viewport is clipped so page-entry animations remain
                    inside the glass surface.
                    -->
                    <Grid x:Name="ItemsViewport"
                          Grid.Row="0"
                          ClipToBounds="True">
                        <UniformGrid x:Name="ItemsPanel"
                                     Rows="3"
                                     Columns="4"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5">
                            <UniformGrid.RenderTransform>
                                <TranslateTransform X="0" Y="0"/>
                            </UniformGrid.RenderTransform>
                        </UniformGrid>

                        <TextBlock x:Name="EmptyState"
                                   Text="Empty folder"
                                   Visibility="Collapsed"
                                   Foreground="#96E6EEF8"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>

                        <!-- Lifted app visuals live above the UniformGrid while
                             the original card remains as the moving placeholder. -->
                        <Canvas x:Name="DragOverlay"
                                Panel.ZIndex="20"
                                IsHitTestVisible="False"/>
                    </Grid>

                    <StackPanel x:Name="PageIndicators"
                                Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
