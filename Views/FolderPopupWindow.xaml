<Window x:Class="SmoothFolder.Views.FolderPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="540"
        Height="400"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        AllowDrop="True">
    <Border x:Name="PopupCard"
            Margin="1"
            CornerRadius="30"
            RenderTransformOrigin="0.5,0.5"
            BorderBrush="#70FFFFFF"
            BorderThickness="1">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>

        <Grid>
            <!-- Layered highlights make the translucent tint read as glass while
                 keeping the outer HWND completely transparent. -->
            <Border Margin="1"
                    CornerRadius="29"
                    IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#32FFFFFF" Offset="0"/>
                        <GradientStop Color="#14FFFFFF" Offset="0.30"/>
                        <GradientStop Color="#05000000" Offset="0.62"/>
                        <GradientStop Color="#16000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border Margin="1"
                    CornerRadius="29"
                    BorderBrush="#32FFFFFF"
                    BorderThickness="1"
                    IsHitTestVisible="False"/>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleText"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="4,0,0,20"/>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}"
                               BasedOn="{StaticResource GlassScrollBarStyle}"/>
                    </ScrollViewer.Resources>
                    <WrapPanel x:Name="ItemsPanel"
                               Orientation="Horizontal"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
