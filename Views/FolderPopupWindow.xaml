<Window x:Class="SmoothFolder.Views.FolderPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="540"
        Height="444"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid x:Name="PopupRoot"
          Margin="1"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
                <TranslateTransform X="0" Y="0"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- iOS-style folder title: outside the glass surface, top-left. -->
        <Border Grid.Row="0"
                Background="Transparent"
                Margin="12,0,0,2"
                Cursor="SizeAll"
                MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
            <TextBlock x:Name="TitleText"
                       FontFamily="{DynamicResource UiFontFamily}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
        </Border>

        <Border x:Name="PopupCard"
                Grid.Row="1"
                CornerRadius="30"
                BorderBrush="#70FFFFFF"
                BorderThickness="1">
            <Grid>
                <!-- Layered highlights make the translucent tint read as glass. -->
                <Border Margin="1"
                        CornerRadius="29"
                        IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#32FFFFFF" Offset="0"/>
                            <GradientStop Color="#14FFFFFF" Offset="0.30"/>
                            <GradientStop Color="#05000000" Offset="0.62"/>
                            <GradientStop Color="#16000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border Margin="1"
                        CornerRadius="29"
                        BorderBrush="#32FFFFFF"
                        BorderThickness="1"
                        IsHitTestVisible="False"/>

                <Grid Margin="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}"
                                   BasedOn="{StaticResource GlassScrollBarStyle}"/>
                        </ScrollViewer.Resources>

                        <WrapPanel x:Name="ItemsPanel"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Left"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
