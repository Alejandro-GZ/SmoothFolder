<Window x:Class="SmoothFolder.Views.GlassTintDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500"
        Height="590"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmoothFolder;component/Resources/GlassControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="DialogCard"
            Margin="1"
            CornerRadius="30"
            Background="Transparent"
            BorderBrush="#58FFFFFF"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Border x:Name="DialogTintLayer"
                    Margin="1"
                    CornerRadius="29"
                    IsHitTestVisible="False"/>

            <Border Margin="1"
                    CornerRadius="29"
                    IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2AFFFFFF" Offset="0"/>
                        <GradientStop Color="#08FFFFFF" Offset="0.32"/>
                        <GradientStop Color="#02000000" Offset="0.70"/>
                        <GradientStop Color="#18000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border Margin="1"
                    CornerRadius="29"
                    BorderBrush="#24FFFFFF"
                    BorderThickness="1"
                    IsHitTestVisible="False"/>

            <Grid Margin="24,22,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="Transparent"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock Text="Glass tint"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="23"
                                   FontWeight="SemiBold">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#B8000000"
                                                  BlurRadius="6"
                                                  ShadowDepth="1"
                                                  Opacity="0.70"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1"
                            Margin="0,20,0,16">
                    <TextBlock Text="PRESETS"
                               Margin="2,0,0,9"
                               FontFamily="{DynamicResource UiFontFamily}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10.5"
                               FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Tag="#3C5064" ToolTip="Slate" Background="#3C5064"
                                Style="{StaticResource GlassTintPresetButtonStyle}"
                                Margin="0,0,10,0" Click="Preset_Click"/>
                        <Button Tag="#24272E" ToolTip="Graphite" Background="#24272E"
                                Style="{StaticResource GlassTintPresetButtonStyle}"
                                Margin="0,0,10,0" Click="Preset_Click"/>
                        <Button Tag="#5B4B73" ToolTip="Violet" Background="#5B4B73"
                                Style="{StaticResource GlassTintPresetButtonStyle}"
                                Margin="0,0,10,0" Click="Preset_Click"/>
                        <Button Tag="#315E5A" ToolTip="Teal" Background="#315E5A"
                                Style="{StaticResource GlassTintPresetButtonStyle}"
                                Margin="0,0,10,0" Click="Preset_Click"/>
                        <Button Tag="#6B4658" ToolTip="Rose" Background="#6B4658"
                                Style="{StaticResource GlassTintPresetButtonStyle}"
                                Margin="0,0,10,0" Click="Preset_Click"/>
                        <Button Tag="#5B5140" ToolTip="Warm" Background="#5B5140"
                                Style="{StaticResource GlassTintPresetButtonStyle}"
                                Click="Preset_Click"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="2"
                        Style="{StaticResource GlassCardStyle}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Color"
                                           FontFamily="{DynamicResource UiFontFamily}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Hex RGB value"
                                           Margin="0,2,0,0"
                                           FontFamily="{DynamicResource UiFontFamily}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10.5"/>
                            </StackPanel>

                            <TextBox x:Name="HexBox"
                                     Grid.Column="1"
                                     Style="{StaticResource GlassTextBoxStyle}"
                                     TextChanged="HexBox_TextChanged"/>
                        </Grid>

                        <Border Height="1"
                                Margin="0,14"
                                Background="#24FFFFFF"/>

                        <Grid Margin="0,0,0,7">
                            <TextBlock Text="Tint strength"
                                       FontFamily="{DynamicResource UiFontFamily}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"/>
                            <Border HorizontalAlignment="Right"
                                    Padding="8,3"
                                    CornerRadius="8"
                                    Background="#1FFFFFFF"
                                    BorderBrush="#2CFFFFFF"
                                    BorderThickness="1">
                                <TextBlock x:Name="OpacityValueText"
                                           FontFamily="{DynamicResource UiFontFamily}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="11.5"/>
                            </Border>
                        </Grid>

                        <Slider x:Name="OpacitySlider"
                                Style="{StaticResource GlassSliderStyle}"
                                Minimum="0.12"
                                Maximum="0.72"
                                TickFrequency="0.01"
                                ValueChanged="OpacitySlider_ValueChanged"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="LIVE MATERIAL PREVIEW"
                               Margin="2,0,0,8"
                               FontFamily="{DynamicResource UiFontFamily}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10.5"
                               FontWeight="SemiBold"/>

                    <Border x:Name="Preview"
                            Height="148"
                            CornerRadius="22"
                            BorderBrush="#58FFFFFF"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PreviewTintLayer"
                                    CornerRadius="21"
                                    IsHitTestVisible="False"/>

                            <Border CornerRadius="21"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#32FFFFFF" Offset="0"/>
                                        <GradientStop Color="#04FFFFFF" Offset="0.46"/>
                                        <GradientStop Color="#15000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Grid Margin="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="86"
                                        Height="86"
                                        CornerRadius="24"
                                        Background="#19FFFFFF"
                                        BorderBrush="#45FFFFFF"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <UniformGrid Rows="3"
                                                 Columns="3"
                                                 Margin="14">
                                        <Border Margin="2" CornerRadius="5" Background="#D9F3F7FF"/>
                                        <Border Margin="2" CornerRadius="5" Background="#B7D9E8FF"/>
                                        <Border Margin="2" CornerRadius="5" Background="#CFE9D8FF"/>
                                        <Border Margin="2" CornerRadius="5" Background="#D9F6C6D2"/>
                                        <Border Margin="2" CornerRadius="5" Background="#C7E8D8FF"/>
                                        <Border Margin="2" CornerRadius="5" Background="#CFEEDFBF"/>
                                        <Border Margin="2" CornerRadius="5" Background="#C7DCCBFF"/>
                                        <Border Margin="2" CornerRadius="5" Background="#D9F2E5FF"/>
                                        <Border Margin="2" CornerRadius="5" Background="#CFE7D9E9"/>
                                    </UniformGrid>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="14,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Games"
                                               FontFamily="{DynamicResource UiFontFamily}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="19"
                                               FontWeight="SemiBold">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#C8000000"
                                                              BlurRadius="6"
                                                              ShadowDepth="1"
                                                              Opacity="0.75"/>
                                        </TextBlock.Effect>
                                    </TextBlock>

                                    <TextBlock Text="A compact preview over the same blurred backdrop."
                                               Margin="0,5,0,9"
                                               TextWrapping="Wrap"
                                               FontFamily="{DynamicResource UiFontFamily}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10.5"/>

                                    <Border HorizontalAlignment="Left"
                                            Padding="9,4"
                                            CornerRadius="9"
                                            Background="#1C000000"
                                            BorderBrush="#28FFFFFF"
                                            BorderThickness="1">
                                        <TextBlock x:Name="PreviewValueText"
                                                   FontFamily="{DynamicResource UiFontFamily}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="10.5"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="4"
                      Margin="0,18,0,0">
                    <Button Content="Cancel"
                            Width="92"
                            HorizontalAlignment="Left"
                            Style="{StaticResource GlassButtonStyle}"
                            Click="Cancel_Click"/>

                    <Button Content="Apply"
                            Width="92"
                            HorizontalAlignment="Right"
                            Style="{StaticResource GlassPrimaryButtonStyle}"
                            Click="Apply_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
