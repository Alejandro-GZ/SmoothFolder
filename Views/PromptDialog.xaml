<Window x:Class="SmoothFolder.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380"
        Height="170"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Padding="20"
            CornerRadius="22"
            Background="#B8141A22"
            BorderBrush="#55FFFFFF"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Margin="-19"
                    Grid.RowSpan="3"
                    CornerRadius="21"
                    IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2CFFFFFF" Offset="0"/>
                        <GradientStop Color="#0CFFFFFF" Offset="0.38"/>
                        <GradientStop Color="#14000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border Background="Transparent"
                    Cursor="SizeAll"
                    Margin="0,0,0,12"
                    MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                <TextBlock x:Name="PromptText"
                           FontFamily="{DynamicResource UiFontFamily}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="2,0,0,0"/>
            </Border>

            <TextBox x:Name="ValueBox"
                     Grid.Row="1"
                     Height="36"
                     VerticalContentAlignment="Center"
                     FontFamily="{DynamicResource UiFontFamily}"
                     FontSize="14"
                     Padding="10,0"
                     BorderThickness="1"/>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                <Button Content="Cancel"
                        Width="86"
                        Height="32"
                        Margin="0,14,8,0"
                        Click="Cancel_Click"/>
                <Button Content="Save"
                        Width="86"
                        Height="32"
                        Margin="0,14,0,0"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
