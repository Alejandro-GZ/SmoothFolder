<Window x:Class="SmoothFolder.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620"
        Height="620"
        MinWidth="620"
        MinHeight="620"
        MaxWidth="620"
        MaxHeight="620"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SmoothFolder;component/Resources/GlassControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="IosSwitchStyle"
                   TargetType="{x:Type CheckBox}">
                <Setter Property="Width"
                        Value="48"/>
                <Setter Property="Height"
                        Value="28"/>
                <Setter Property="Cursor"
                        Value="Hand"/>
                <Setter Property="FocusVisualStyle"
                        Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type CheckBox}">
                            <Border x:Name="Track"
                                    Width="48"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="#26FFFFFF"
                                    BorderBrush="#35FFFFFF"
                                    BorderThickness="1">
                                <Grid>
                                    <Ellipse x:Name="Knob"
                                             Width="20"
                                             Height="20"
                                             Margin="4,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Fill="#FFF9FCFF"
                                             Stroke="#80FFFFFF"
                                             StrokeThickness="1">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="5"
                                                              ShadowDepth="1"
                                                              Opacity="0.28"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked"
                                         Value="True">
                                    <Setter TargetName="Track"
                                            Property="Background"
                                            Value="#705AC8FA"/>
                                    <Setter TargetName="Track"
                                            Property="BorderBrush"
                                            Value="#72FFFFFF"/>
                                    <Setter TargetName="Knob"
                                            Property="HorizontalAlignment"
                                            Value="Right"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="Track"
                                            Property="BorderBrush"
                                            Value="#9AFFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="SettingsCard"
            Margin="1"
            CornerRadius="30"
            Background="Transparent"
            BorderBrush="#58FFFFFF"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Border x:Name="SettingsTintLayer"
                    Margin="1"
                    CornerRadius="29"
                    IsHitTestVisible="False"/>

            <Border Margin="1"
                    CornerRadius="29"
                    IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="#2AFFFFFF"
                                      Offset="0"/>
                        <GradientStop Color="#08FFFFFF"
                                      Offset="0.30"/>
                        <GradientStop Color="#03000000"
                                      Offset="0.68"/>
                        <GradientStop Color="#18000000"
                                      Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border Margin="1"
                    CornerRadius="29"
                    BorderBrush="#24FFFFFF"
                    BorderThickness="1"
                    IsHitTestVisible="False"/>

            <Grid Margin="24,20,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="54"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="Settings"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="24"
                                   FontWeight="SemiBold">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#B8000000"
                                                  BlurRadius="6"
                                                  ShadowDepth="1"
                                                  Opacity="0.70"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <Button Width="36"
                            Height="36"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Content="×"
                            FontSize="18"
                            Style="{StaticResource GlassButtonStyle}"
                            Click="Close_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Margin="0,0,-6,0"
                              Padding="0,0,12,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}"
                               BasedOn="{StaticResource GlassScrollBarStyle}"/>
                    </ScrollViewer.Resources>

                    <StackPanel>
                        <TextBlock Text="APPEARANCE"
                                   Margin="4,0,0,9"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"/>

                        <Border Style="{StaticResource GlassCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Blur strength"
                                                   FontFamily="{DynamicResource UiFontFamily}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Gaussian blur applied to every live glass surface."
                                                   Margin="0,2,0,7"
                                                   FontFamily="{DynamicResource UiFontFamily}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10.5"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Padding="8,3"
                                            CornerRadius="8"
                                            Background="#1FFFFFFF"
                                            BorderBrush="#2CFFFFFF"
                                            BorderThickness="1">
                                        <TextBlock x:Name="BlurValueText"
                                                   FontFamily="{DynamicResource UiFontFamily}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="11.5"/>
                                    </Border>
                                </Grid>

                                <Slider x:Name="BlurSlider"
                                        Style="{StaticResource GlassSliderStyle}"
                                        Minimum="0"
                                        Maximum="20"
                                        TickFrequency="0.5"
                                        ValueChanged="AppearanceSlider_ValueChanged"/>

                                <Border Height="1"
                                        Margin="0,14"
                                        Background="#24FFFFFF"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Tint strength"
                                                   FontFamily="{DynamicResource UiFontFamily}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Global tint intensity used by tiles, folders and menus."
                                                   Margin="0,2,0,7"
                                                   FontFamily="{DynamicResource UiFontFamily}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10.5"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Padding="8,3"
                                            CornerRadius="8"
                                            Background="#1FFFFFFF"
                                            BorderBrush="#2CFFFFFF"
                                            BorderThickness="1">
                                        <TextBlock x:Name="TintValueText"
                                                   FontFamily="{DynamicResource UiFontFamily}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="11.5"/>
                                    </Border>
                                </Grid>

                                <Slider x:Name="TintSlider"
                                        Style="{StaticResource GlassSliderStyle}"
                                        Minimum="0"
                                        Maximum="0.70"
                                        TickFrequency="0.01"
                                        ValueChanged="AppearanceSlider_ValueChanged"/>

                                <Border Height="1"
                                        Margin="0,14"
                                        Background="#24FFFFFF"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Saturation"
                                                   FontFamily="{DynamicResource UiFontFamily}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Color intensity retained through the blurred backdrop."
                                                   Margin="0,2,0,7"
                                                   FontFamily="{DynamicResource UiFontFamily}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10.5"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Padding="8,3"
                                            CornerRadius="8"
                                            Background="#1FFFFFFF"
                                            BorderBrush="#2CFFFFFF"
                                            BorderThickness="1">
                                        <TextBlock x:Name="SaturationValueText"
                                                   FontFamily="{DynamicResource UiFontFamily}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="11.5"/>
                                    </Border>
                                </Grid>

                                <Slider x:Name="SaturationSlider"
                                        Style="{StaticResource GlassSliderStyle}"
                                        Minimum="0"
                                        Maximum="1"
                                        TickFrequency="0.05"
                                        ValueChanged="AppearanceSlider_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="BEHAVIOR"
                                   Margin="4,20,0,9"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"/>

                        <Border Style="{StaticResource GlassCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Start with Windows"
                                               FontFamily="{DynamicResource UiFontFamily}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Launch SmoothFolder automatically after you sign in."
                                               Margin="0,3,0,0"
                                               FontFamily="{DynamicResource UiFontFamily}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10.5"/>
                                </StackPanel>

                                <CheckBox x:Name="StartWithWindowsToggle"
                                          Grid.Column="1"
                                          Margin="20,0,0,0"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource IosSwitchStyle}"
                                          Click="StartWithWindowsToggle_Click"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2"
                      Margin="0,14,0,0">
                    <Button Content="Reset appearance"
                            HorizontalAlignment="Left"
                            Style="{StaticResource GlassButtonStyle}"
                            Click="ResetAppearance_Click"/>

                    <Button Content="Done"
                            Width="92"
                            HorizontalAlignment="Right"
                            Style="{StaticResource GlassPrimaryButtonStyle}"
                            Click="Done_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
