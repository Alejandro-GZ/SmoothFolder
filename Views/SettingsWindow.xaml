<Window x:Class="SmoothFolder.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620"
        Height="590"
        MinWidth="620"
        MinHeight="590"
        MaxWidth="620"
        MaxHeight="590"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style x:Key="SettingsCardStyle"
               TargetType="{x:Type Border}">
            <Setter Property="CornerRadius"
                    Value="20"/>
            <Setter Property="Background"
                    Value="#18FFFFFF"/>
            <Setter Property="BorderBrush"
                    Value="#26FFFFFF"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="18"/>
        </Style>

        <Style x:Key="SettingsSliderStyle"
               TargetType="{x:Type Slider}">
            <Setter Property="Height"
                    Value="28"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="IsMoveToPointEnabled"
                    Value="True"/>
        </Style>

        <Style x:Key="IosSwitchStyle"
               TargetType="{x:Type CheckBox}">
            <Setter Property="Width"
                    Value="46"/>
            <Setter Property="Height"
                    Value="26"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="Track"
                                Width="46"
                                Height="26"
                                CornerRadius="13"
                                Background="#34FFFFFF">
                            <Grid>
                                <Ellipse x:Name="Knob"
                                         Width="22"
                                         Height="22"
                                         Margin="2"
                                         HorizontalAlignment="Left"
                                         Fill="#FFFDFEFF">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6"
                                                          ShadowDepth="1"
                                                          Opacity="0.28"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="Track"
                                        Property="Background"
                                        Value="#FF5AC8FA"/>
                                <Setter TargetName="Knob"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Track"
                                        Property="Opacity"
                                        Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background"
                    Value="#18FFFFFF"/>
            <Setter Property="BorderBrush"
                    Value="#28FFFFFF"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="16,8"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Margin="1"
            CornerRadius="30"
            BorderBrush="#52FFFFFF"
            BorderThickness="1"
            Background="#EC151922">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32"
                              ShadowDepth="10"
                              Opacity="0.40"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="82"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Margin="28,19,90,0">
                    <TextBlock Text="Settings"
                               FontFamily="{DynamicResource UiFontFamily}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Customize how SmoothFolder looks and behaves."
                               Margin="0,4,0,0"
                               FontFamily="{DynamicResource UiFontFamily}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"/>
                </StackPanel>

                <Button Width="34"
                        Height="34"
                        Margin="0,18,22,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Content="×"
                        FontSize="20"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Background="#14FFFFFF"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="Close_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="22,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Appearance"
                               Margin="6,0,0,8"
                               FontFamily="{DynamicResource UiFontFamily}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Blur strength"
                                               FontFamily="{DynamicResource UiFontFamily}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Controls the Gaussian blur used by the glass material."
                                               Margin="0,3,0,0"
                                               FontFamily="{DynamicResource UiFontFamily}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"/>
                                </StackPanel>

                                <TextBlock x:Name="BlurValueText"
                                           Grid.Column="1"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontFamily="{DynamicResource UiFontFamily}"
                                           FontSize="12"/>
                            </Grid>

                            <Slider x:Name="BlurSlider"
                                    Style="{StaticResource SettingsSliderStyle}"
                                    Minimum="0"
                                    Maximum="20"
                                    TickFrequency="0.5"
                                    ValueChanged="AppearanceSlider_ValueChanged"/>

                            <Separator Margin="0,16"
                                       Background="#22FFFFFF"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Tint strength"
                                               FontFamily="{DynamicResource UiFontFamily}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Controls how strongly the tint colors the glass."
                                               Margin="0,3,0,0"
                                               FontFamily="{DynamicResource UiFontFamily}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"/>
                                </StackPanel>

                                <TextBlock x:Name="TintValueText"
                                           Grid.Column="1"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontFamily="{DynamicResource UiFontFamily}"
                                           FontSize="12"/>
                            </Grid>

                            <Slider x:Name="TintSlider"
                                    Style="{StaticResource SettingsSliderStyle}"
                                    Minimum="0"
                                    Maximum="0.70"
                                    TickFrequency="0.01"
                                    ValueChanged="AppearanceSlider_ValueChanged"/>

                            <Separator Margin="0,16"
                                       Background="#22FFFFFF"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Saturation"
                                               FontFamily="{DynamicResource UiFontFamily}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Adjusts the color intensity retained through the glass."
                                               Margin="0,3,0,0"
                                               FontFamily="{DynamicResource UiFontFamily}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"/>
                                </StackPanel>

                                <TextBlock x:Name="SaturationValueText"
                                           Grid.Column="1"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontFamily="{DynamicResource UiFontFamily}"
                                           FontSize="12"/>
                            </Grid>

                            <Slider x:Name="SaturationSlider"
                                    Style="{StaticResource SettingsSliderStyle}"
                                    Minimum="0.50"
                                    Maximum="1.40"
                                    TickFrequency="0.05"
                                    ValueChanged="AppearanceSlider_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Behavior"
                               Margin="6,20,0,8"
                               FontFamily="{DynamicResource UiFontFamily}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Start with Windows"
                                           FontFamily="{DynamicResource UiFontFamily}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Launch SmoothFolder automatically after you sign in."
                                           Margin="0,3,0,0"
                                           FontFamily="{DynamicResource UiFontFamily}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"/>
                            </StackPanel>

                            <CheckBox x:Name="StartWithWindowsToggle"
                                      Grid.Column="1"
                                      Margin="20,0,0,0"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource IosSwitchStyle}"
                                      Click="StartWithWindowsToggle_Click"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="StatusText"
                               MinHeight="20"
                               Margin="6,12,6,0"
                               TextWrapping="Wrap"
                               FontFamily="{DynamicResource UiFontFamily}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2"
                  Margin="22,10,22,16">
                <Button Content="Reset appearance"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Left"
                        Click="ResetAppearance_Click"/>

                <Button Content="Done"
                        Width="88"
                        HorizontalAlignment="Right"
                        Foreground="#FF071018"
                        Background="#FFBFEAFF"
                        BorderBrush="#55FFFFFF"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="Done_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
